{
  "name": "guess-the-beat",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "tsx scripts/desarrollo.ts",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/servidor.ts",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/servidor.ts",
    "db:setup": "tsx scripts/preparar-base-datos.ts",
    "db:migrate:recovery": "tsx scripts/migrar-codigo-recuperacion.ts",
    "music:sync": "tsx scripts/sincronizar-musica.ts",
    "test": "tsx --test tests/*.test.ts",
    "test:integration": "tsx scripts/probar-integracion.ts",
    "check": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "mysql:stop": "tsx scripts/detener-mysql-local.ts"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "mysql2": "^3.15.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "socket.io": "^4.8.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.5",
    "@types/node": "^24.10.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
